{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://service-requirement-blueprint.example/schemas/evidence-export-records.v1.schema.json",
  "$defs": {
    "deliveries": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "kind", "predecessor_delivery_id", "remediated_inspection_id", "sha256", "byte_length", "submitted_by_id", "submitted_by_role", "submitted_at", "review_due_at", "fixed_record"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "version": {"type": "integer", "minimum": 1, "maximum": 20},
          "kind": {"enum": ["INITIAL", "REMEDIATION"]},
          "predecessor_delivery_id": {"type": ["string", "null"], "format": "uuid"},
          "remediated_inspection_id": {"type": ["string", "null"], "format": "uuid"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_length": {"type": "integer", "minimum": 1, "maximum": 1048576},
          "submitted_by_id": {"type": "string", "format": "uuid"},
          "submitted_by_role": {"const": "contractor"},
          "submitted_at": {"type": "string", "format": "date-time"},
          "review_due_at": {"type": "string", "format": "date-time"},
          "fixed_record": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "delivery_id", "case_id", "formal_candidate_id", "version", "kind", "predecessor_delivery_id", "remediated_inspection_id", "submitted_by_id", "submitted_by_role", "summary", "items", "test_results", "submitted_at", "review_due_at"],
            "properties": {
              "schema_version": {"const": "delivery-record/1.0"},
              "delivery_id": {"type": "string", "format": "uuid"},
              "case_id": {"type": "string", "format": "uuid"},
              "formal_candidate_id": {"type": "string", "format": "uuid"},
              "version": {"type": "integer", "minimum": 1, "maximum": 20},
              "kind": {"enum": ["INITIAL", "REMEDIATION"]},
              "predecessor_delivery_id": {"type": ["string", "null"], "format": "uuid"},
              "remediated_inspection_id": {"type": ["string", "null"], "format": "uuid"},
              "submitted_by_id": {"type": "string", "format": "uuid"},
              "submitted_by_role": {"const": "contractor"},
              "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["criterion_id", "description", "verification_method", "delivery_note", "evidence_reference"],
                  "properties": {
                    "criterion_id": {"type": "string", "format": "uuid"},
                    "description": {"type": "string", "minLength": 1, "maxLength": 4000},
                    "verification_method": {"type": "string", "minLength": 1, "maxLength": 4000},
                    "delivery_note": {"type": "string", "minLength": 1, "maxLength": 4000},
                    "evidence_reference": {"type": "string", "minLength": 1, "maxLength": 1000}
                  }
                }
              },
              "test_results": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["criterion_id", "outcome", "observation"],
                  "properties": {
                    "criterion_id": {"type": "string", "format": "uuid"},
                    "outcome": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
                    "observation": {"type": "string", "minLength": 1, "maxLength": 4000}
                  }
                }
              },
              "submitted_at": {"type": "string", "format": "date-time"},
              "review_due_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    "inspections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "delivery_id", "round", "kind", "decision", "explicit_acceptance", "inspected_by_id", "inspected_by_role", "inspected_at", "results"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "delivery_id": {"type": "string", "format": "uuid"},
          "round": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["INITIAL", "REINSPECTION"]},
          "decision": {"enum": ["ACCEPTED", "RETURNED"]},
          "explicit_acceptance": {"type": "boolean"},
          "inspected_by_id": {"type": "string", "format": "uuid"},
          "inspected_by_role": {"const": "client"},
          "inspected_at": {"type": "string", "format": "date-time"},
          "results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "inspection_id", "delivery_item_id", "criterion_id", "result", "reason"],
              "properties": {
                "id": {"type": "string", "format": "uuid"},
                "inspection_id": {"type": "string", "format": "uuid"},
                "delivery_item_id": {"type": "string", "format": "uuid"},
                "criterion_id": {"type": "string", "format": "uuid"},
                "result": {"enum": ["PASS", "RETURNED"]},
                "reason": {"type": ["string", "null"], "maxLength": 4000}
              }
            }
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "case_id", "event_code", "entity_type", "entity_id", "actor_id", "actor_role", "occurred_at", "effective_at"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "case_id": {"type": "string", "format": "uuid"},
          "event_code": {"enum": ["DELIVERY_SUBMITTED", "REVIEW_DEADLINE_SET", "INSPECTION_STARTED", "INSPECTION_RETURNED", "DELIVERY_ACCEPTED", "REMEDIATION_SUBMITTED", "DISPUTE_OPENED", "DISPUTE_POSITION_ADDED"]},
          "entity_type": {"enum": ["DELIVERY", "INSPECTION", "DISPUTE"]},
          "entity_id": {"type": "string", "format": "uuid"},
          "actor_id": {"type": ["string", "null"], "format": "uuid"},
          "actor_role": {"type": ["string", "null"], "enum": ["client", "contractor", null]},
          "occurred_at": {"type": "string", "format": "date-time"},
          "effective_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "dispute": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "delivery_id", "inspection_id", "prior_state", "opened_by_id", "opened_by_role", "reason", "opened_at", "positions"],
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "delivery_id": {"type": "string", "format": "uuid"},
            "inspection_id": {"type": ["string", "null"], "format": "uuid"},
            "prior_state": {"enum": ["DELIVERED", "UNDER_ACCEPTANCE", "REMEDIATION", "REINSPECTION"]},
            "opened_by_id": {"type": "string", "format": "uuid"},
            "opened_by_role": {"enum": ["client", "contractor"]},
            "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
            "opened_at": {"type": "string", "format": "date-time"},
            "positions": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "dispute_id", "actor_id", "actor_role", "position_text", "submitted_at"],
                "properties": {
                  "id": {"type": "string", "format": "uuid"},
                  "dispute_id": {"type": "string", "format": "uuid"},
                  "actor_id": {"type": "string", "format": "uuid"},
                  "actor_role": {"enum": ["client", "contractor"]},
                  "position_text": {"type": "string", "minLength": 1, "maxLength": 4000},
                  "submitted_at": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        }
      ]
    },
    "acceptance": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "case_id", "formal_candidate_id", "delivery_id", "inspection_id", "accepted_by_id", "evidence_sha256", "accepted_at"],
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "case_id": {"type": "string", "format": "uuid"},
            "formal_candidate_id": {"type": "string", "format": "uuid"},
            "delivery_id": {"type": "string", "format": "uuid"},
            "inspection_id": {"type": "string", "format": "uuid"},
            "accepted_by_id": {"type": "string", "format": "uuid"},
            "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "accepted_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    }
  }
}
