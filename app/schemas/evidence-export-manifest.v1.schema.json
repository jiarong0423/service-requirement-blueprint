{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/evidence-export-manifest.v1.schema.json",
  "title": "Evidence Export Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_id", "case_id", "formal_candidate_id", "workflow_state", "version", "prepared_at", "source_fingerprint", "entries", "exclusions"],
  "properties": {
    "schema_version": {"const": "evidence-export/1.0"},
    "export_id": {"type": "string", "format": "uuid"},
    "case_id": {"type": "string", "format": "uuid"},
    "formal_candidate_id": {"type": "string", "format": "uuid"},
    "workflow_state": {"enum": ["ACCEPTED", "DISPUTED"]},
    "version": {"type": "integer", "minimum": 1},
    "prepared_at": {"type": "string", "format": "date-time"},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 9,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byte_length", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 200},
          "byte_length": {"type": "integer", "minimum": 1, "maximum": 50331648},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "exclusions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
  }
}
